  </aside>
  <div class="nova-main">
    <div class="nova-top">
      <div class="nova-crumb">用户管理 / <b>会话监控</b></div>
      <div class="nova-top-right"><span class="nova-dot"></span> 服务运行中</div>
    </div>
    <div class="nova-content">
    
        <h1>会话管理</h1>
        <p>查看当前活动会话、强制用户下线</p>
        <div class="card">
            
            <div class="operation-bar">
                <button id="refreshSessions" class="btn primary">刷新会话列表</button>
            </div>
            
            <div id="sessionsContainer">
                <div class="loading">正在加载会话信息...</div>
            </div>
        </div>
    </div>

    <!-- 断开连接确认对话框 -->
    <div id="disconnectModal" class="modal">
        <div class="modal-content">
            <h3>确认断开连接</h3>
            <p>您确定要断开该用户的连接吗？</p>
            <p>此操作不会注销用户的应用程序，用户可以重新连接到会话。</p>
            <p><strong>用户名：</strong><span id="disconnectUsername"></span></p>
            <div class="modal-footer">
                <button id="cancelDisconnect" class="btn secondary">取消</button>
                <button id="confirmDisconnect" class="btn warning">确认断开</button>
            </div>
        </div>
    </div>

    <!-- 下线确认对话框 -->
    <div id="logoffModal" class="modal">
        <div class="modal-content">
            <h3>确认下线</h3>
            <p>您确定要强制下线该用户会话吗？</p>
            <p><strong>用户名：</strong><span id="logoffUsername"></span></p>
            <div class="modal-footer">
                <button id="cancelLogoff" class="btn secondary">取消</button>
                <button id="confirmLogoff" class="btn danger">确认下线</button>
            </div>
        </div>
    </div>

    <!-- 发送消息对话框 -->
    <div id="messageModal" class="modal">
        <div class="modal-content">
            <h3>发送消息</h3>
            <p><strong>用户名：</strong><span id="messageUsername"></span></p>
            <div class="form-group">
                <label for="messageContent">消息内容：</label>
                <textarea id="messageContent" rows="4" placeholder="请输入要发送的消息"></textarea>
            </div>
            <div class="modal-footer">
                <button id="cancelMessage" class="btn secondary">取消</button>
                <button id="confirmMessage" class="btn success">发送消息</button>
            </div>
        </div>
    </div>

    <script>
        // 当前待操作的会话ID
        let currentSessionId = null;
        let currentDisconnectSessionId = null;
        let currentMessageSessionId = null;
        
        // 定时刷新间隔（毫秒）
        const AUTO_REFRESH_INTERVAL = 30000; // 30秒
        let refreshInterval;
        
        // 页面加载完成后执行
        document.addEventListener('DOMContentLoaded', function() {
            // 初始加载会话列表
            loadSessions();
            
            // 刷新按钮事件
            document.getElementById('refreshSessions').addEventListener('click', function() {
                loadSessions();
            });
            
            // 下线确认按钮事件
            document.getElementById('confirmLogoff').addEventListener('click', function() {
                if (currentSessionId) {
                    sessionLogoffUser(currentSessionId);
                }
            });
            
            // 取消下线按钮事件
            document.getElementById('cancelLogoff').addEventListener('click', function() {
                closeLogoffModal();
            });
            
            // 断开连接确认按钮事件
            document.getElementById('confirmDisconnect').addEventListener('click', function() {
                if (currentDisconnectSessionId) {
                    sessionDisconnectUser(currentDisconnectSessionId);
                }
            });
            
            // 取消断开连接按钮事件
            document.getElementById('cancelDisconnect').addEventListener('click', function() {
                closeDisconnectModal();
            });
            
            // 移除自动刷新，只在页面加载和手动刷新时获取会话信息
            // startAutoRefresh(); // 已禁用自动刷新
            
            // 显示页面加载提示
            showMessage('页面已加载，正在获取会话信息...', 'info');
            
            // 页面离开时清除定时器
            window.addEventListener('beforeunload', stopAutoRefresh);

            // 发送消息确认按钮事件
            document.getElementById('confirmMessage').addEventListener('click', function() {
                if (currentMessageSessionId) {
                    sendMessageToUser(currentMessageSessionId);
                }
            });

            // 取消发送消息按钮事件
            document.getElementById('cancelMessage').addEventListener('click', function() {
                closeMessageModal();
            });
        });
        
        // 启动自动刷新
        function startAutoRefresh() {
            // 清除可能存在的定时器，避免重复设置
            stopAutoRefresh();
            
            // 设置新的定时器
            refreshInterval = setInterval(function() {
                console.log('自动刷新会话列表...');
                loadSessions();
            }, AUTO_REFRESH_INTERVAL);
        }
        
        // 停止自动刷新
        function stopAutoRefresh() {
            if (refreshInterval) {
                clearInterval(refreshInterval);
                refreshInterval = null;
            }
        }
        
        // 加载会话信息
        function loadSessions() {
            const container = document.getElementById('sessionsContainer');
            const refreshBtn = document.getElementById('refreshSessions');
            
            // 禁用刷新按钮，避免重复请求
            refreshBtn.disabled = true;
            refreshBtn.innerHTML = '<i class="loading-icon"></i> 加载中...';
            container.innerHTML = '<div class="loading">正在加载会话信息，请稍候...</div>';
            
            fetch('/api/sessions')
                .then(response => {
                    // 检查响应状态
                    if (!response.ok) {
                        throw new Error(`HTTP错误: ${response.status} ${response.statusText}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('会话数据获取成功:', data);
                    
                    if (data.success) {
                        // 添加调试信息显示
                        let debugInfo = '';
                        if (data.debugInfo && data.debugInfo.message) {
                            debugInfo = `<div class="debug-info">${data.debugInfo.message}</div>`;
                        }
                        
                        if (data.sessions.length === 0) {
                            container.innerHTML = `
                                ${debugInfo}
                                <div class="empty-state">
                                    <h4>当前没有检测到活动会话</h4>
                                    <p>如果您确认有客户端已连接，请尝试以下操作：</p>
                                    <ul>
                                        <li>检查服务器上的实际连接情况</li>
                                        <li>确保应用以管理员权限运行</li>
                                        <li>点击刷新按钮重试</li>
                                    </ul>
                                    <button class="btn" onclick="loadSessions()">重新尝试</button>
                                </div>
                            `;
                        } else {
                            // 生成会话表格
                            let html = `
                                ${debugInfo}
                                <div class="session-stats">共 ${data.sessions.length} 个活动会话</div>
                                <div class="table-container">
<table class="table">
                                    <thead>
                                        <tr>
                                            <th>会话ID</th>
                                            <th>用户名</th>
                                            <th>状态</th>
                                            <th>登录时间</th>
                                            <th>在线时长</th>
                                            <th>操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                            `;
                            
                            data.sessions.forEach(session => {
                                // 确保所有必要字段都有值
                                const safeSessionId = session.sessionId || '未知';
                                const safeUsername = session.username || '未知';
                                const safeState = session.state || '未知';
                                const safeLoginTime = session.loginTime || '未知';
                                const safeDuration = session.duration || '未知';
                                
                                // 添加状态样式
                                let stateClass = '';
                                if (safeState.includes('活动')) stateClass = 'state-active';
                                else if (safeState.includes('断开')) stateClass = 'state-disconnected';
                                else if (safeState.includes('空闲')) stateClass = 'state-idle';
                                
                                html += `
                                    <tr>
                                        <td>${safeSessionId}</td>
                                        <td>${safeUsername}</td>
                                        <td class="${stateClass}">${safeState}</td>
                                        <td>${safeLoginTime}</td>
                                        <td>${safeDuration}</td>
                                        <td>
                    <button class="btn warning" onclick="confirmDisconnect('${safeSessionId}', '${safeUsername}')">断开连接</button>
                    <button class="btn danger" onclick="confirmLogoff('${safeSessionId}', '${safeUsername}')">强制下线</button>
                    <button class="btn success" onclick="confirmSendMessage('${safeSessionId}', '${safeUsername}')">发送消息</button>
                </td>
                                    </tr>
                                `;
                            });
                            
                            html += '</tbody></table></div>';
                            container.innerHTML = html;
                        }
                    } else {
                        // 显示详细错误信息
                        let errorDetails = data.message || '未知错误';
                        if (data.debugInfo && data.debugInfo.message) {
                            errorDetails += `<br>${data.debugInfo.message}`;
                        }
                        
                        container.innerHTML = `
                            <div class="error">
                                <h4>加载失败</h4>
                                <p>${errorDetails}</p>
                                <button class="btn" onclick="loadSessions()">重试</button>
                            </div>
                        `;
                        showMessage('会话列表加载失败，请稍后重试', 'error');
                    }
                })
                .catch(error => {
                    console.error('加载会话时出错:', error);
                    container.innerHTML = `
                        <div class="error">
                            <h4>加载失败</h4>
                            <p>网络错误或服务器连接问题</p>
                            <p>详细信息: ${error.message}</p>
                            <button class="btn" onclick="loadSessions()">重新连接</button>
                        </div>
                    `;
                    showMessage('网络错误，请检查连接后重试', 'error');
                })
                .finally(() => {
                    // 恢复刷新按钮状态
                    refreshBtn.disabled = false;
                    refreshBtn.innerHTML = '刷新会话列表';
                });
        }
        
        // 确认断开连接
        function confirmDisconnect(sessionId, username) {
            currentDisconnectSessionId = sessionId;
            document.getElementById('disconnectUsername').textContent = username;
            document.getElementById('disconnectModal').classList.add('show');
        }
        
        // 关闭断开连接确认对话框
        function closeDisconnectModal() {
            currentDisconnectSessionId = null;
            const modal = document.getElementById('disconnectModal');
            modal.classList.remove('show');
            
            // 恢复按钮状态
            const confirmBtn = document.getElementById('confirmDisconnect');
            confirmBtn.disabled = false;
            confirmBtn.textContent = '确认断开';
        }
        
        // 确认下线
        function confirmLogoff(sessionId, username) {
            currentSessionId = sessionId;
            document.getElementById('logoffUsername').textContent = username;
            document.getElementById('logoffModal').classList.add('show');
        }
        
        // 关闭下线确认对话框
        function closeLogoffModal() {
            currentSessionId = null;
            const modal = document.getElementById('logoffModal');
            modal.classList.remove('show');
            
            // 恢复按钮状态
            const confirmBtn = document.getElementById('confirmLogoff');
            confirmBtn.disabled = false;
            confirmBtn.textContent = '确认下线';
        }

        // 确认发送消息
        function confirmSendMessage(sessionId, username) {
            currentMessageSessionId = sessionId;
            document.getElementById('messageUsername').textContent = username;
            document.getElementById('messageContent').value = ''; // 清空消息内容
            document.getElementById('messageModal').classList.add('show');
        }

        // 关闭发送消息对话框
        function closeMessageModal() {
            currentMessageSessionId = null;
            const modal = document.getElementById('messageModal');
            modal.classList.remove('show');
            
            // 恢复按钮状态
            const confirmBtn = document.getElementById('confirmMessage');
            confirmBtn.disabled = false;
            confirmBtn.textContent = '发送消息';
        }
        
        // 断开用户连接
        function sessionDisconnectUser(sessionId) {
            const confirmBtn = document.getElementById('confirmDisconnect');
            // 禁用确认按钮，避免重复提交
            confirmBtn.disabled = true;
            confirmBtn.textContent = '处理中...';

            fetch(`/api/disconnect/${sessionId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                // 检查响应状态
                if (!response.ok) {
                    throw new Error(`HTTP错误: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                closeDisconnectModal();
                if (data.success) {
                    showMessage('用户连接已成功断开，但应用程序仍在运行', 'success');
                    // 立即刷新会话列表，确保用户看到最新状态
                    loadSessions();
                } else {
                    showMessage('断开连接失败：' + (data.message || '未知错误'), 'error');
                }
            })
            .catch(error => {
                console.error('断开连接时出错:', error);
                closeDisconnectModal();
                showMessage('断开连接失败，请检查会话ID是否正确', 'error');
            })
            .finally(() => {
                // 恢复按钮状态
                confirmBtn.disabled = false;
                confirmBtn.textContent = '确认断开';
            });
        }

        // 下线用户
        function sessionLogoffUser(sessionId) {
            const confirmBtn = document.getElementById('confirmLogoff');
            // 禁用确认按钮，避免重复提交
            confirmBtn.disabled = true;
            confirmBtn.textContent = '处理中...';
            
            fetch(`/api/logoff/${sessionId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                // 检查响应状态
                if (!response.ok) {
                    throw new Error(`HTTP错误: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                closeLogoffModal();
                if (data.success) {
                    showMessage('用户已成功下线', 'success');
                    // 立即刷新会话列表，确保用户看到最新状态
                    loadSessions();
                } else {
                    showMessage('下线失败：' + (data.message || '未知错误'), 'error');
                }
            })
            .catch(error => {
                console.error('强制下线时出错:', error);
                closeLogoffModal();
                showMessage('强制下线失败，请检查会话ID是否正确', 'error');
            })
            .finally(() => {
                // 恢复按钮状态
                confirmBtn.disabled = false;
                confirmBtn.textContent = '确认下线';
            });
        }
        
        // 发送消息给用户
        function sendMessageToUser(sessionId) {
            const confirmBtn = document.getElementById('confirmMessage');
            const messageContent = document.getElementById('messageContent').value.trim();
            
            // 验证消息内容
            if (!messageContent) {
                showMessage('请输入消息内容', 'error');
                return;
            }
            
            // 禁用确认按钮，避免重复提交
            confirmBtn.disabled = true;
            confirmBtn.textContent = '发送中...';

            fetch(`/api/send-message/${sessionId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ message: messageContent })
            })
            .then(response => {
                // 确保无论状态如何都解析JSON，这样可以获取服务器返回的错误信息
                return response.json().then(data => {
                    if (!response.ok) {
                        // 即使状态码不是2xx，也从数据中获取错误信息
                        throw new Error(data.message || `HTTP错误: ${response.status}`);
                    }
                    return data;
                });
            })
            .then(data => {
                closeMessageModal();
                if (data.success) {
                    showMessage('消息发送成功', 'success');
                } else {
                    // 显示服务器返回的具体错误信息
                    showMessage('消息发送失败：' + (data.message || '未知错误'), 'error');
                    console.log('服务器返回的错误信息:', data.message);
                }
            })
            .catch(error => {
                console.error('发送消息时出错:', error);
                closeMessageModal();
                // 显示更详细的错误信息给用户
                showMessage('消息发送失败：' + error.message, 'error');
            })
            .finally(() => {
                // 恢复按钮状态
                confirmBtn.disabled = false;
                confirmBtn.textContent = '发送消息';
            });
        }

        // 显示消息
        function showMessage(message, type = 'info') {
            // 移除所有现有的消息，避免消息堆积
            const existingMessages = document.querySelectorAll('.message');
            existingMessages.forEach(msg => msg.remove());
            
            // 创建消息元素
            const msgDiv = document.createElement('div');
            msgDiv.className = `message ${type}`;
            msgDiv.textContent = message;
            
            // 添加到页面
            document.body.appendChild(msgDiv);
            
            // 3秒后自动移除
            setTimeout(() => {
                msgDiv.classList.add('fade-out');
                setTimeout(() => {
                    if (msgDiv.parentNode) {
                        document.body.removeChild(msgDiv);
                    }
                }, 300);
            }, 3000);
        }
    </script>
</div>
</div>
</body>
</html>