  <div class="nova-main">
    <div class="nova-top">
      <div class="nova-crumb">系统 / <b>安全中心</b></div>
      <div class="nova-top-right"><span class="nova-dot"></span> 服务运行中</div>
    </div>
    <div class="nova-content">
    
        <h1>安全操作中心</h1>
        <p>全面保护您的服务器安全，执行各项安全管理操作</p>
        <div class="card">
            
            <!-- 安全功能网格 -->
            <div class="security-features">
                <div class="security-card">
                    <h3><i class="fas fa-user-shield"></i> 账户安全检查</h3>
                    <p>全面检查系统账户状态，识别潜在安全风险，保护管理员权限安全</p>
                    <button id="checkAccountSecurity" class="btn primary">
                        <i class="fas fa-search"></i> 执行检查
                    </button>
                </div>
                
                <div class="security-card">
                    <h3><i class="fas fa-key"></i> 管理员权限验证</h3>
                    <p>验证当前运行环境的权限级别，确保系统以正确权限运行</p>
                    <button id="verifyAdmin" class="btn success">
                        <i class="fas fa-check-circle"></i> 验证权限
                    </button>
                </div>
                
                <div class="security-card">
                    <h3><i class="fas fa-history"></i> 操作日志查看</h3>
                    <p>查看详细的系统操作记录，追踪所有管理活动历史</p>
                    <button id="viewLogs" class="btn warning">
                        <i class="fas fa-file-alt"></i> 查看日志
                    </button>
                </div>
                
                <div class="security-card">
                    <h3><i class="fas fa-clock"></i> 授权检查间隔设置</h3>
                    <p>自定义系统检查授权过期的时间频率，确保及时发现授权问题</p>
                    <div class="interval-setting">
                        <input type="number" id="checkInterval" min="1" max="120" value="10" class="interval-input" placeholder="分钟">
                        <span class="interval-unit">分钟</span>
                        <button id="saveInterval" class="btn primary">
                            <i class="fas fa-save"></i> 保存设置
                        </button>
                    </div>
                    <div id="intervalMessage" class="message"></div>
                </div>
                
                <div class="security-card">
                    <h3><i class="fas fa-power-off"></i> 账户权限设置</h3>
                    <p>罗列每个账户，设置「电源关机是否可用」权限，控制账户的电源关机操作</p>
                    <button id="manageAccountPerms" class="btn primary">
                        <i class="fas fa-users-cog"></i> 账户权限管理
                    </button>
                </div>
                
                <div class="security-card">
                    <h3><i class="fas fa-user-clock"></i> 登录会话有效期设置</h3>
                    <p>自定义登录会话的过期时间，控制用户登录后保持登录状态的时长</p>
                    <div class="interval-setting">
                        <input type="number" id="sessionTimeout" min="1" max="240" value="60" class="interval-input" placeholder="分钟">
                        <span class="interval-unit">分钟</span>
                        <button id="saveSessionTimeout" class="btn primary">
                            <i class="fas fa-save"></i> 保存设置
                        </button>
                    </div>
                    <div id="sessionTimeoutMessage" class="message"></div>
                </div>
            </div>
            
            <!-- 结果显示区域 -->
            <div id="securityResults" class="results-container">
                <!-- 结果将在这里动态显示 -->
                <div style="text-align: center; padding: 40px; color: #666;">
                    <i class="fas fa-info-circle" style="font-size: 48px; margin-bottom: 15px; opacity: 0.5;"></i>
                    <p>请选择上方的安全功能执行操作</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 账户权限设置模态框 -->
    <div id="accountPermsModal" class="modal">
        <div class="modal-content" style="max-width: 720px;">
            <div class="modal-header">
                <h3>账户权限设置</h3>
                <span class="close-button" onclick="closeAccountPermsModal()">&times;</span>
            </div>
            <p style="color:#64748b;font-size:13px;margin-bottom:14px;">设置每个账户「电源关机是否可用」：开启后该账户拥有电源关机权限，关闭后不可执行关机操作。</p>
            <div class="table-wrapper" style="max-height: 420px; overflow-y: auto;">
                <table class="table" id="accountPermsTable">
                    <thead>
                        <tr>
                            <th>账户名</th>
                            <th>状态</th>
                            <th>电源关机可用</th>
                        </tr>
                    </thead>
                    <tbody id="accountPermsBody">
                        <tr><td colspan="3">加载中...</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="form-actions" style="margin-top:16px;">
                <button type="button" class="btn secondary" onclick="closeAccountPermsModal()">关闭</button>
            </div>
        </div>
    </div>

    <script>
        // 页面加载完成后执行
        document.addEventListener('DOMContentLoaded', function() {
            // 绑定按钮事件
            document.getElementById('checkAccountSecurity').addEventListener('click', checkAccountSecurity);
            document.getElementById('verifyAdmin').addEventListener('click', verifyAdmin);
            document.getElementById('viewLogs').addEventListener('click', viewLogs);
            document.getElementById('saveInterval').addEventListener('click', saveCheckInterval);
            document.getElementById('saveSessionTimeout').addEventListener('click', saveSessionTimeout);
            document.getElementById('manageAccountPerms').addEventListener('click', openAccountPermsModal);
            
            // 加载当前的设置
            loadCurrentCheckInterval();
            loadCurrentSessionTimeout();
        });
        
        // ===== 账户权限设置（电源关机可用）=====
        function openAccountPermsModal() {
            const modal = document.getElementById('accountPermsModal');
            modal.style.display = 'block';
            setTimeout(() => modal.classList.add('show'), 10);
            loadAccountPerms();
        }
        
        function closeAccountPermsModal() {
            const modal = document.getElementById('accountPermsModal');
            modal.classList.remove('show');
            setTimeout(() => { modal.style.display = 'none'; }, 200);
        }
        
        function loadAccountPerms() {
            const tbody = document.getElementById('accountPermsBody');
            tbody.innerHTML = '<tr><td colspan="3">加载中...</td></tr>';
            fetch('/api/users')
                .then(r => r.json())
                .then(data => {
                    if (!data.success || !data.users) {
                        tbody.innerHTML = '<tr><td colspan="3">加载失败</td></tr>';
                        return;
                    }
                    renderAccountPerms(data.users);
                })
                .catch(() => {
                    tbody.innerHTML = '<tr><td colspan="3">加载失败</td></tr>';
                });
        }
        
        function renderAccountPerms(users) {
            const tbody = document.getElementById('accountPermsBody');
            tbody.innerHTML = '';
            users.forEach(user => {
                const tr = document.createElement('tr');
                const stateText = user.disabled ? '已禁用' : '启用';
                const stateColor = user.disabled ? '#dc2626' : '#16a34a';
                const permOn = user.shutdownPerm !== false; // 默认可用
                tr.innerHTML = `
                    <td style="font-weight:600;">${user.name}</td>
                    <td><span style="color:${stateColor};font-weight:500;">${stateText}</span></td>
                    <td>
                        <label style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
                            <input type="checkbox" ${permOn ? 'checked' : ''} onchange="setAccountShutdownPerm('${user.name}', this.checked)" style="width:auto;">
                            <span>${permOn ? '可用' : '不可用'}</span>
                        </label>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }
        
        function setAccountShutdownPerm(username, enabled) {
            fetch('/api/security/account-shutdown-perm', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username: username, enabled: enabled })
            })
            .then(r => r.json())
            .then(data => {
                // 更新开关状态文字
                const rows = document.querySelectorAll('#accountPermsBody tr');
                rows.forEach(row => {
                    if (row.textContent.includes(username)) {
                        const span = row.querySelector('span');
                        if (span) span.textContent = enabled ? '可用' : '不可用';
                    }
                });
                const msg = document.createElement('div');
                msg.className = 'message ' + (data.success ? 'success' : 'error');
                msg.textContent = data.message || (data.success ? '设置成功' : '设置失败');
                msg.style.marginTop = '10px';
                const modal = document.getElementById('accountPermsModal');
                const oldMsg = modal.querySelector('.perm-msg');
                if (oldMsg) oldMsg.remove();
                msg.classList.add('perm-msg');
                modal.querySelector('.form-actions').before(msg);
                setTimeout(() => msg.remove(), 3000);
            })
            .catch(() => {});
        }
        
        // 加载当前的检查间隔设置
        function loadCurrentCheckInterval() {
            fetch('/api/settings/authorization-interval')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('checkInterval').value = data.interval;
                    }
                })
                .catch(error => {
                    console.error('加载检查间隔失败:', error);
                });
        }
        
        // 加载当前的会话超时设置
        function loadCurrentSessionTimeout() {
            fetch('/api/settings/session-timeout')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('sessionTimeout').value = data.timeout;
                    }
                })
                .catch(error => {
                    console.error('加载会话超时设置失败:', error);
                });
        }
        
        // 保存检查间隔设置
        function saveCheckInterval() {
            const intervalInput = document.getElementById('checkInterval');
            const messageDiv = document.getElementById('intervalMessage');
            const interval = parseInt(intervalInput.value);
            
            // 验证输入
            if (isNaN(interval) || interval < 1 || interval > 120) {
                messageDiv.textContent = '请输入1-120之间的整数';
                messageDiv.className = 'message error';
                return;
            }
            
            // 显示保存中状态
            const saveButton = document.getElementById('saveInterval');
            const originalText = saveButton.textContent;
            saveButton.disabled = true;
            saveButton.textContent = '保存中...';
            messageDiv.className = 'message';
        }
        
        // 保存会话超时设置
        function saveSessionTimeout() {
            const timeoutInput = document.getElementById('sessionTimeout');
            const messageDiv = document.getElementById('sessionTimeoutMessage');
            const timeout = parseInt(timeoutInput.value);
            
            // 验证输入
            if (isNaN(timeout) || timeout < 1 || timeout > 240) {
                messageDiv.textContent = '请输入1-240之间的整数';
                messageDiv.className = 'message error';
                return;
            }
            
            // 显示保存中状态
            const saveButton = document.getElementById('saveSessionTimeout');
            const originalText = saveButton.textContent;
            saveButton.disabled = true;
            saveButton.textContent = '保存中...';
            messageDiv.className = 'message';
            
            // 发送请求保存设置
            fetch('/api/settings/session-timeout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ timeout })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    messageDiv.textContent = '设置已保存，系统将使用新的会话超时时间';
                    messageDiv.className = 'message success';
                } else {
                    messageDiv.textContent = `保存失败: ${data.error || '未知错误'}`;
                    messageDiv.className = 'message error';
                }
            })
            .catch(error => {
                console.error('保存会话超时设置失败:', error);
                messageDiv.textContent = '保存失败，请稍后重试';
                messageDiv.className = 'message error';
            })
            .finally(() => {
                // 恢复按钮状态
                saveButton.disabled = false;
                saveButton.textContent = originalText;
                
                // 3秒后隐藏消息
                setTimeout(() => {
                    messageDiv.className = 'message';
                }, 3000);
            });
        }
        
        // 检查账户安全
        function checkAccountSecurity() {
            const resultsContainer = document.getElementById('securityResults');
            resultsContainer.innerHTML = '<div class="loading">正在执行账户安全检查...</div>';
            
            fetch('/api/security/check-accounts')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        let html = '<h3><i class="fas fa-shield-alt"></i> 账户安全检查结果</h3>';
                        html += '<div class="security-report">';
                        
                        if (data.adminAccounts && data.adminAccounts.length > 0) {
                            html += '<div class="security-section">';
                            html += '<h4><i class="fas fa-users-cog"></i> 管理员账户列表</h4>';
                            html += '<ul>';
                            data.adminAccounts.forEach(admin => {
                                html += `<li><i class="fas fa-user-circle"></i> ${admin}</li>`;
                            });
                            html += '</ul>';
                            html += '</div>';
                        }
                        
                        if (data.recentLogins && data.recentLogins.length > 0) {
                            html += '<div class="security-section">';
                            html += '<h4><i class="fas fa-sign-in-alt"></i> 最近登录活动</h4>';
                            html += '<div class="table-container"><table class="table">';
                            html += '<thead><tr><th>账号名</th><th>登录时间</th><th>IP地址</th></tr></thead>';
                            html += '<tbody>';
                            data.recentLogins.forEach(login => {
                                html += `<tr><td><i class="fas fa-user"></i> ${login.username}</td><td><i class="fas fa-clock"></i> ${login.time}</td><td><i class="fas fa-globe"></i> ${login.ip || '本地登录'}</td></tr>`;
                            });
                            html += '</tbody></table></div>';
                            html += '</div>';
                        }
                        
                        if (data.securityTips && data.securityTips.length > 0) {
                            html += '<div class="security-section">';
                            html += '<h4><i class="fas fa-lightbulb"></i> 安全建议</h4>';
                            html += '<ul>';
                            data.securityTips.forEach(tip => {
                                html += `<li><i class="fas fa-exclamation-circle"></i> ${tip}</li>`;
                            });
                            html += '</ul>';
                            html += '</div>';
                        }
                        
                        // 如果没有数据显示空状态
                        if ((!data.adminAccounts || data.adminAccounts.length === 0) && 
                            (!data.recentLogins || data.recentLogins.length === 0) && 
                            (!data.securityTips || data.securityTips.length === 0)) {
                            html += '<div class="message info">' +
                                '<i class="fas fa-info-circle"></i> 未发现账户安全问题，系统安全状态良好' +
                            '</div>';
                        }
                        
                        html += '</div>';
                        resultsContainer.innerHTML = html;
                    } else {
                        resultsContainer.innerHTML = `<div class="error-message">
                            <i class="fas fa-exclamation-triangle"></i> 检查失败：${data.message || '未知错误'}
                        </div>`;
                    }
                })
                .catch(error => {
                    resultsContainer.innerHTML = `<div class="error-message">
                        <i class="fas fa-times-circle"></i> 检查失败：${error.message || '网络错误'}
                    </div>`;
                });
        }
        
        // 验证管理员权限
        function verifyAdmin() {
            const resultsContainer = document.getElementById('securityResults');
            resultsContainer.innerHTML = '<div class="loading">正在验证管理员权限...</div>';
            
            fetch('/api/security/check-admin')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        let html = '<h3><i class="fas fa-key"></i> 管理员权限验证结果</h3>';
                        html += '<div class="security-report">';
                        
                        if (data.isAdmin) {
                            html += '<div class="success-message">' +
                                '<i class="fas fa-check-circle"></i> 系统正在以管理员权限运行' +
                            '</div>';
                            html += '<p style="padding: 15px; background-color: #e8f5e9; border-radius: 6px;">' +
                                '<i class="fas fa-info-circle" style="color: #27ae60; margin-right: 10px;"></i>' +
                                '您拥有完整的管理权限，可以执行所有系统操作和配置' +
                            '</p>';
                        } else {
                            html += '<div class="warning-message">' +
                                '<i class="fas fa-exclamation-circle"></i> 系统未以管理员权限运行' +
                            '</div>';
                            html += '<p style="padding: 15px; background-color: #fff3cd; border-radius: 6px;">' +
                                '<i class="fas fa-lightbulb" style="color: #f39c12; margin-right: 10px;"></i>' +
                                '部分高级管理功能可能无法正常使用，建议以管理员身份重新启动应用程序以获得完整功能' +
                            '</p>';
                        }
                        
                        // 添加权限相关信息
                        html += '<div class="security-section">';
                        html += '<h4><i class="fas fa-info-circle"></i> 权限信息</h4>';
                        html += '<p>当前环境：' + (data.environment || '未知') + '</p>';
                        if (data.permissions) {
                            html += '<ul>';
                            Object.entries(data.permissions).forEach(([key, value]) => {
                                const statusClass = value ? 'success' : 'error';
                                const statusIcon = value ? 'check' : 'times';
                                html += `<li><strong>${key}:</strong> <span class="${statusClass}"><i class="fas fa-${statusIcon}"></i> ${value ? '已授权' : '未授权'}</span></li>`;
                            });
                            html += '</ul>';
                        }
                        html += '</div>';
                        
                        html += '</div>';
                        resultsContainer.innerHTML = html;
                    } else {
                        resultsContainer.innerHTML = `<div class="error-message">
                            <i class="fas fa-exclamation-triangle"></i> 验证失败：${data.message || '未知错误'}
                        </div>`;
                    }
                })
                .catch(error => {
                    resultsContainer.innerHTML = `<div class="error-message">
                        <i class="fas fa-times-circle"></i> 验证失败：${error.message || '网络错误'}
                    </div>`;
                });
        }
        
        // 查看日志
        function viewLogs() {
            const resultsContainer = document.getElementById('securityResults');
            resultsContainer.innerHTML = '<div class="loading">正在加载操作日志...</div>';
            
            fetch('/api/security/logs')
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        let html = '<h3><i class="fas fa-history"></i> 操作日志</h3>';
                        html += '<div class="security-report">';
                        
                        if (data.logs && data.logs.length > 0) {
                            // 统计信息
                            const successCount = data.logs.filter(log => log.success).length;
                            const errorCount = data.logs.filter(log => !log.success).length;
                            
                            html += '<div class="security-section" style="background-color: #f8f9fa; padding: 15px; border-radius: 8px;">';
                            html += '<div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 15px;">';
                            html += `<div><strong>总记录数:</strong> ${data.logs.length}</div>`;
                            html += `<div><strong>成功操作:</strong> <span class="success">${successCount}</span></div>`;
                            html += `<div><strong>失败操作:</strong> <span class="error">${errorCount}</span></div>`;
                            html += '</div>';
                            html += '</div>';
                            
                            html += '<div class="security-section">';
                            html += '<div style="overflow-x: auto;">';
                            html += '<div class="table-container"><table class="table">';
                            html += '<thead><tr><th>时间</th><th>操作类型</th><th>操作内容</th><th>结果</th></tr></thead>';
                            html += '<tbody>';
                            data.logs.forEach(log => {
                                const resultClass = log.success ? 'success' : 'error';
                                const resultIcon = log.success ? 'check-circle' : 'times-circle';
                                const typeIcon = getOperationTypeIcon(log.type);
                                
                                html += `<tr>
                                    <td><i class="fas fa-clock"></i> ${log.time}</td>
                                    <td><i class="fas fa-${typeIcon}"></i> ${log.type}</td>
                                    <td>${log.detail}</td>
                                    <td class="${resultClass}"><i class="fas fa-${resultIcon}"></i> ${log.success ? '成功' : '失败'}</td>
                                </tr>`;
                            });
                            html += '</tbody></table></div>';
                            html += '</div>';
                            html += '</div>';
                        } else {
                            html += '<div class="message info">' +
                                '<i class="fas fa-info-circle"></i> 暂无操作日志记录' +
                            '</div>';
                        }
                        
                        html += '</div>';
                        resultsContainer.innerHTML = html;
                    } else {
                        resultsContainer.innerHTML = `<div class="error-message">
                            <i class="fas fa-exclamation-triangle"></i> 加载失败：${data.message || '未知错误'}
                        </div>`;
                    }
                })
                .catch(error => {
                    resultsContainer.innerHTML = `<div class="error-message">
                        <i class="fas fa-times-circle"></i> 加载失败：${error.message || '网络错误'}
                    </div>`;
                });
        }
        
        // 根据操作类型获取对应的图标
        function getOperationTypeIcon(type) {
            const iconMap = {
                '登录': 'sign-in-alt',
                '登出': 'sign-out-alt',
                '修改': 'edit',
                '删除': 'trash-alt',
                '添加': 'plus-circle',
                '查询': 'search',
                '安全': 'shield-alt',
                '权限': 'key',
                '配置': 'cog'
            };
            
            for (const [key, icon] of Object.entries(iconMap)) {
                if (type.includes(key)) {
                    return icon;
                }
            }
            
            return 'file-alt';
        }
        
        // 显示消息
        function showMessage(message, type = 'info') {
            // 定义图标映射
            const iconMap = {
                success: 'check-circle',
                error: 'exclamation-circle',
                warning: 'exclamation-triangle',
                info: 'info-circle'
            };
            
            // 创建消息元素
            const msgDiv = document.createElement('div');
            msgDiv.className = `message ${type}`;
            msgDiv.innerHTML = `<i class="fas fa-${iconMap[type] || 'info-circle'}"></i> ${message}`;
            
            // 添加到页面
            document.body.appendChild(msgDiv);
            
            // 添加淡入动画
            setTimeout(() => {
                msgDiv.style.opacity = '1';
            }, 10);
            
            // 3秒后自动移除
            setTimeout(() => {
                msgDiv.style.opacity = '0';
                setTimeout(() => {
                    if (document.body.contains(msgDiv)) {
                        document.body.removeChild(msgDiv);
                    }
                }, 300);
            }, 3000);
        }
    </script>
</div>
</div>
</body>
</html>