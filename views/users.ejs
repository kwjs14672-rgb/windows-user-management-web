            </form>
        </div>
    </div>
    

    
    <!-- 删除用户确认模态框 -->
    <div id="deleteUserModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>删除账号</h3>
                <span class="close-button" onclick="closeDeleteUserModal()">&times;</span>
            </div>
            <div style="padding: 6px 0 16px;">
                <p style="margin: 0 0 10px;">确定要删除账号 <strong id="deleteUsernameText"></strong> 吗？</p>
                <p style="margin: 0; color: #e74c3c; font-size: 13px;">⚠ 删除后该账号将无法登录系统，此操作不可恢复！</p>
            </div>
            <div class="form-actions">
                <button type="button" class="btn secondary" onclick="closeDeleteUserModal()">取消</button>
                <button type="button" class="btn danger" onclick="confirmDeleteUser()">确认删除</button>
            </div>
        </div>
    </div>

    <!-- 消息提示 -->
    <div id="message" class="message"></div>
    
    <script>
        // 全局变量
        let currentUsers = [];
        let selectedUsername = '';
        
        // DOM元素
        const userTableBody = document.getElementById('userTableBody');
        const loading = document.getElementById('loading');
        const editUserModal = document.getElementById('editUserModal');
        const addUserModal = document.getElementById('addUserModal');
        const changePasswordModal = document.getElementById('changePasswordModal');
        const deleteUserModal = document.getElementById('deleteUserModal');
        const editUserForm = document.getElementById('editUserForm');
        const addUserForm = document.getElementById('addUserForm');
        const changePasswordForm = document.getElementById('changePasswordForm');
        const message = document.getElementById('message');
        
        // 页面加载完成后执行
        document.addEventListener('DOMContentLoaded', function() {
            loadUsers();
            loadUserPrefix();
            
            // 表单提交事件
            editUserForm.addEventListener('submit', function(event) {
                event.preventDefault();
                saveUserInfo();
            });
            
            addUserForm.addEventListener('submit', function(event) {
                event.preventDefault();
                addNewUser();
            });
            
            changePasswordForm.addEventListener('submit', function(event) {
                event.preventDefault();
                updatePassword();
            });
            
            // 密码输入框事件监听
            document.getElementById('newPassword').addEventListener('input', function() {
                checkPasswordStrength(this.value, 'passwordStrengthBar', 'passwordStrengthText');
                checkPasswordMatch(this.value, document.getElementById('confirmPassword').value);
            });
            
            document.getElementById('confirmPassword').addEventListener('input', function() {
                checkPasswordMatch(document.getElementById('newPassword').value, this.value);
            });
            
            document.getElementById('changePassword').addEventListener('input', function() {
                checkPasswordStrength(this.value, 'changePasswordStrengthBar', 'changePasswordStrengthText');
                checkChangePasswordMatch(this.value, document.getElementById('confirmChangePassword').value);
            });
            
            document.getElementById('confirmChangePassword').addEventListener('input', function() {
                checkChangePasswordMatch(document.getElementById('changePassword').value, this.value);
            });
            
            // 搜索框回车事件
            document.getElementById('searchInput').addEventListener('keypress', function(event) {
                if (event.key === 'Enter') {
                    searchUser();
                }
            });
        });
        
        // 加载用户列表
        function loadUsers() {
            loading.classList.add('show');
            
            fetch('/api/users')
                .then(response => response.json())
                .then(data => {
                    loading.classList.remove('show');
                    
                    if (data.success) {
                        currentUsers = data.users;
                        renderUserTable(currentUsers);
                    } else {
                        showMessage('获取用户列表失败: ' + data.message, 'error');
                    }
                })
                .catch(error => {
                    loading.classList.remove('show');
                    showMessage('获取用户列表时发生错误: ' + error.message, 'error');
                });
        }
        
        // 刷新用户列表
        function refreshUserList() {
            loadUsers(); // 调用现有函数重新加载用户列表
        }
        
        // 渲染用户表格
        function renderUserTable(users) {
            userTableBody.innerHTML = '';
            
            if (users.length === 0) {
                userTableBody.innerHTML = '<tr><td colspan="5" style="text-align: center;">没有找到用户</td></tr>';
                return;
            }
            
            users.forEach(user => {
                const row = document.createElement('tr');
                
                // 状态标签
                const statusClass = user.disabled ? 'status-badge disabled' : 'status-badge enabled';
                const statusText = user.disabled ? '已禁用' : '已启用';
                
                // 处理可能不存在的字段
                const fullname = user.fullname || user.fullName || '-';
                const description = user.description || '-';
                
                // 根据用户状态设置按钮类名和文本
                const toggleActionClass = user.disabled ? 'success' : 'danger';
                const toggleActionText = user.disabled ? '启用' : '禁用';
                
                row.innerHTML = `
                    <td>${user.name}</td>
                    <td><span class="${statusClass}">${statusText}</span></td>
                    <td>${fullname}</td>
                    <td>${description}</td>
                    <td>
                        <button class="btn small primary action-btn" onclick="openEditUserModal('${user.name}')">编辑</button>
                        <button class="btn small secondary action-btn" onclick="openChangePasswordModal('${user.name}')">修改密码</button>
                        <button class="btn small ${toggleActionClass} action-btn" onclick="toggleUserStatus('${user.name}', ${!user.disabled})">${toggleActionText}</button>
                        <button class="btn small danger action-btn" onclick="openDeleteUserModal('${user.name}')">删除</button>
                    </td>
                `;
                
                userTableBody.appendChild(row);
            });
        }
        
        // 搜索用户
        function searchUser() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            
            const filteredUsers = currentUsers.filter(user => 
                user.name.toLowerCase().includes(searchTerm)
            );
            
            renderUserTable(filteredUsers);
        }
        
        // 打开编辑用户模态框
        function openEditUserModal(username) {
            selectedUsername = username;
            
            // 查找用户信息
            const user = currentUsers.find(u => u.name === username);
            if (user) {
                document.getElementById('editUsername').value = user.name;
                document.getElementById('editFullName').value = user.fullname || user.fullName || '';
                document.getElementById('editDescription').value = user.description || '';
                document.getElementById('editStatus').value = user.disabled ? 'disabled' : 'enabled';
            }
            
            editUserModal.style.display = 'block';
            // 触发重排后添加动画类
            setTimeout(() => {
                editUserModal.classList.add('show');
            }, 10);
        }
        
        // 关闭编辑用户模态框
        function closeEditUserModal() {
            editUserModal.classList.remove('show');
            // 等待动画完成后隐藏
            setTimeout(() => {
                editUserModal.style.display = 'none';
                selectedUsername = '';
                editUserForm.reset();
            }, 300);
        }
        
        // 保存用户信息
        function saveUserInfo() {
            const fullName = document.getElementById('editFullName').value;
            const description = document.getElementById('editDescription').value;
            const status = document.getElementById('editStatus').value;
            
            loading.classList.add('show');
            
            // 先更新用户信息
            fetch('/api/users/update-info', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    username: selectedUsername,
                    fullName: fullName,
                    description: description
                })
            })
            .then(response => response.json())
            .then(data => {
                if (!data.success) {
                    loading.classList.remove('show');
                    showMessage('更新用户信息失败: ' + data.message, 'error');
                    return Promise.reject();
                }
                
                // 然后更新用户状态
                const isDisabled = status === 'disabled';
                return fetch('/api/users/set-status', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        username: selectedUsername,
                        disabled: isDisabled
                    })
                });
            })
            .then(response => response.json())
            .then(data => {
                loading.classList.remove('show');
                
                if (data.success) {
                    showMessage('用户信息更新成功', 'success');
                    closeEditUserModal();
                    loadUsers(); // 重新加载用户列表
                } else {
                    showMessage('更新用户状态失败: ' + data.message, 'error');
                }
            })
            .catch(error => {
                loading.classList.remove('show');
                if (error) {
                    showMessage('保存用户信息时发生错误: ' + error.message, 'error');
                }
            });
        }
        
        // 打开新增账号模态框
        function openAddUserModal() {
            addUserForm.reset();
            document.getElementById('passwordStrengthBar').style.width = '0';
            document.getElementById('passwordStrengthText').textContent = '';
            document.getElementById('passwordMatchText').textContent = '';
            
            addUserModal.style.display = 'block';
            // 触发重排后添加动画类
            setTimeout(() => {
                addUserModal.classList.add('show');
            }, 10);
        }
        
        // 关闭新增账号模态框
        function closeAddUserModal() {
            addUserModal.classList.remove('show');
            // 等待动画完成后隐藏
            setTimeout(() => {
                addUserModal.style.display = 'none';
            }, 300);
        }
        
        // 新增账号
        // 优化复选框样式
        const checkboxStyle = document.createElement('style');
        checkboxStyle.textContent = `
            .checkbox-container {
                display: flex !important;
                align-items: center !important;
                gap: 8px !important;
                cursor: pointer !important;
                padding: 5px 0 !important;
                width: auto !important;
                height: auto !important;
                flex-direction: row !important;
            }
            
            .form-checkbox {
                margin: 0 !important;
                width: 18px !important;
                height: 18px !important;
                cursor: pointer !important;
                display: inline-block !important;
                vertical-align: middle !important;
            }
            
            .checkbox-label {
                margin: 0 !important;
                cursor: pointer !important;
                font-size: 14px !important;
                color: #333 !important;
                display: inline-block !important;
                vertical-align: middle !important;
            }
            
            .checkbox-container:hover .checkbox-label {
                color: #2c3e50 !important;
            }
            
            /* 确保表单组不会干扰复选框布局 */
            .form-group {
                display: block;
                margin-bottom: 15px;
            }
        `;
        document.head.appendChild(checkboxStyle);


        

        

        
        // 切换用户状态（启用/禁用）
        function toggleUserStatus(username, disable) {
            const action = disable ? '禁用' : '启用';
            if (confirm(`确定要${action}用户 ${username} 吗？`)) {
                loading.classList.add('show');
                
                fetch('/api/users/set-status', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        username: username,
                        disabled: disable
                    })
                })
                .then(response => response.json())
                .then(data => {
                    loading.classList.remove('show');
                    
                    if (data.success) {
                        showMessage(`用户已成功${action}`, 'success');
                        loadUsers(); // 重新加载用户列表
                    } else {
                        showMessage(`${action}用户失败: ` + data.message, 'error');
                    }
                })
                .catch(error => {
                    loading.classList.remove('show');
                    showMessage(`${action}用户时发生错误: ` + error.message, 'error');
                });
            }
        }
        
        // 删除用户相关
        let deleteTargetUsername = '';
        
        // 打开删除用户确认模态框
        function openDeleteUserModal(username) {
            deleteTargetUsername = username;
            document.getElementById('deleteUsernameText').textContent = username;
            
            deleteUserModal.style.display = 'block';
            setTimeout(() => {
                deleteUserModal.classList.add('show');
            }, 10);
        }
        
        // 关闭删除用户确认模态框
        function closeDeleteUserModal() {
            deleteUserModal.classList.remove('show');
            setTimeout(() => {
                deleteUserModal.style.display = 'none';
                deleteTargetUsername = '';
            }, 300);
        }
        
        // 确认删除用户
        function confirmDeleteUser() {
            if (!deleteTargetUsername) return;
            
            loading.classList.add('show');
            
            fetch('/api/users/delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ username: deleteTargetUsername })
            })
            .then(response => response.json())
            .then(data => {
                loading.classList.remove('show');
                
                if (data.success) {
                    showMessage(data.message || '删除成功', 'success');
                    closeDeleteUserModal();
                    loadUsers(); // 重新加载用户列表
                } else {
                    showMessage(data.message || '删除失败', 'error');
                }
            })
            .catch(error => {
                loading.classList.remove('show');
                showMessage('删除用户时发生错误: ' + error.message, 'error');
            });
        }
        
        // 检查密码强度
        function checkPasswordStrength(password, barId, textId) {
            const strengthBar = document.getElementById(barId);
            const strengthText = document.getElementById(textId);
            
            let strength = 0;
            let feedback = '';
            
            // 密码长度检查（最少6位）
            if (password.length >= 6) {
                strength += 25;
            } else {
                feedback = '密码长度至少6个字符';
            }
            
            // 包含数字检查
            if (/[0-9]/.test(password)) {
                strength += 25;
            }
            
            // 包含小写字母检查
            if (/[a-z]/.test(password)) {
                strength += 25;
            }
            
            // 包含大写字母或特殊字符检查
            if (/[A-Z]/.test(password) || /[^A-Za-z0-9]/.test(password)) {
                strength += 25;
            }
            
            // 设置强度条样式
            strengthBar.style.width = `${strength}%`;
            
            // 设置强度条颜色
            if (strength < 25) {
                strengthBar.style.backgroundColor = '#e74c3c';
                if (!feedback) feedback = '密码强度：弱';
            } else if (strength < 50) {
                strengthBar.style.backgroundColor = '#f39c12';
                if (!feedback) feedback = '密码强度：中低';
            } else if (strength < 75) {
                strengthBar.style.backgroundColor = '#f1c40f';
                if (!feedback) feedback = '密码强度：中';
            } else if (strength < 100) {
                strengthBar.style.backgroundColor = '#2ecc71';
                if (!feedback) feedback = '密码强度：良好';
            } else {
                strengthBar.style.backgroundColor = '#27ae60';
                if (!feedback) feedback = '密码强度：强';
            }
            
            strengthText.textContent = feedback;
        }
        
        // 检查密码是否匹配
        function checkPasswordMatch(password, confirmPassword) {
            const matchText = document.getElementById('passwordMatchText');
            
            if (confirmPassword) {
                if (password === confirmPassword) {
                    matchText.textContent = '密码匹配';
                    matchText.style.color = '#27ae60';
                } else {
                    matchText.textContent = '密码不匹配';
                    matchText.style.color = '#e74c3c';
                }
            } else {
                matchText.textContent = '';
            }
        }
        
        // 检查修改密码时的密码匹配
        function checkChangePasswordMatch(password, confirmPassword) {
            const matchText = document.getElementById('changePasswordMatchText');
            
            if (confirmPassword) {
                if (password === confirmPassword) {
                    matchText.textContent = '密码匹配';
                    matchText.style.color = '#27ae60';
                } else {
                    matchText.textContent = '密码不匹配';
                    matchText.style.color = '#e74c3c';
                }
            } else {
                matchText.textContent = '';
            }
        }
        
        // 显示消息提示
        function showMessage(text, type) {
            message.textContent = text;
            message.className = `message ${type} show`;
            
            setTimeout(() => {
                message.className = 'message';
            }, 3000);
        }
        
        // 打开修改密码模态框
        function openChangePasswordModal(username) {
            selectedUsername = username;
            document.getElementById('changePasswordUsername').value = username;
            
            changePasswordModal.style.display = 'block';
            // 触发重排后添加动画类
            setTimeout(() => {
                changePasswordModal.classList.add('show');
            }, 10);
        }
        
        // 关闭修改密码模态框
        function closeChangePasswordModal() {
            changePasswordModal.classList.remove('show');
            // 等待动画完成后隐藏
            setTimeout(() => {
                changePasswordModal.style.display = 'none';
                changePasswordForm.reset();
                document.getElementById('changePasswordStrengthBar').style.width = '0';
                document.getElementById('changePasswordStrengthText').textContent = '';
                document.getElementById('changePasswordMatchText').textContent = '';
            }, 300);
        }
        
        // 更新用户密码
        function updatePassword() {
            const username = selectedUsername;
            const newPassword = document.getElementById('changePassword').value;
            const confirmPassword = document.getElementById('confirmChangePassword').value;
            
            // 验证密码是否一致
            if (newPassword !== confirmPassword) {
                showMessage('两次输入的密码不一致', 'error');
                return;
            }
            
            loading.classList.add('show');
            
            fetch('/api/users/change-password', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    username: username,
                    newPassword: newPassword
                })
            })
            .then(response => response.json())
            .then(data => {
                loading.classList.remove('show');
                
                if (data.success) {
                    showMessage('密码修改成功', 'success');
                    closeChangePasswordModal();
                } else {
                    showMessage('密码修改失败: ' + data.message, 'error');
                }
            })
            .catch(error => {
                loading.classList.remove('show');
                showMessage('修改密码时发生错误: ' + error.message, 'error');
            });
        }
        
        // 点击模态框外部关闭模态框
        window.addEventListener('click', function(event) {
            if (event.target === editUserModal) {
                closeEditUserModal();
            } else if (event.target === addUserModal) {
                closeAddUserModal();
            } else if (event.target === changePasswordModal) {
                closeChangePasswordModal();
            } else if (event.target === deleteUserModal) {
                closeDeleteUserModal();
            }
        });
        
        // 加载用户前缀
        function loadUserPrefix() {
            const savedPrefix = localStorage.getItem('userPrefix');
            const isEnabled = localStorage.getItem('enableUserPrefix') !== 'false';
            if (savedPrefix) {
                document.getElementById('userPrefix').value = savedPrefix;
            }
            document.getElementById('enableUserPrefix').checked = isEnabled;
        }
        
        // 保存用户前缀
        function saveUserPrefix() {
            const prefix = document.getElementById('userPrefix').value;
            const isEnabled = document.getElementById('enableUserPrefix').checked;
            localStorage.setItem('userPrefix', prefix);
            localStorage.setItem('enableUserPrefix', isEnabled.toString());
            showMessage('用户前缀设置保存成功', 'success');
        }
        
        // 修改新增账号函数，应用前缀
        function addNewUser() {
            let username = document.getElementById('newUsername').value;
            const password = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;
            const fullName = document.getElementById('newFullName').value;
            const description = document.getElementById('newDescription').value;
            const isAdmin = document.getElementById('isAdmin').checked;
            
            // 验证密码是否一致
            if (password !== confirmPassword) {
                showMessage('两次输入的密码不一致', 'error');
                return;
            }
            
            // 应用用户前缀（如果启用）
            const isPrefixEnabled = localStorage.getItem('enableUserPrefix') !== 'false';
            const userPrefix = localStorage.getItem('userPrefix') || '';
            if (isPrefixEnabled && userPrefix) {
                username = userPrefix + username;
            }
            
            // 验证用户名长度（最大20个字符）
            const maxUsernameLength = 20;
            if (username.length > maxUsernameLength) {
                showMessage(`用户名长度不能超过${maxUsernameLength}个字符，当前长度为${username.length}个字符`, 'error');
                return;
            }
            
            // 验证用户名格式
            // 修改正则表达式以支持中文和特殊字符
          if (!/^[\w\u4e00-\u9fa5#\-:+]+$/.test(username)) {
            showMessage('用户名只能包含字母、数字、下划线、中文字符和特殊字符(# - : +)', 'error');
            return;
            }
            
            loading.classList.add('show');
            
            fetch('/api/users/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    username: username,
                    password: password,
                    fullName: fullName,
                    description: description,
                    isAdmin: isAdmin
                })
            })
                    .then(response => response.json())
                    .then(data => {
                        loading.classList.remove('show');
                        
                        if (data.success) {
                            showMessage('用户创建成功', 'success');
                            closeAddUserModal();
                            loadUsers(); // 重新加载用户列表
                        } else {
                            showMessage('创建用户失败: ' + data.message, 'error');
                        }
                    })
                    .catch(error => {
                        loading.classList.remove('show');
                        showMessage('创建用户时发生错误: ' + error.message, 'error');
                    });
        }
    </script>
</div>
</div>
</body>
</html>